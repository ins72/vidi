# Copy to /etc/streamgrabber-bridge.env, chmod 600, root-owned.
# Required in production. Generate with: openssl rand -hex 32
BRIDGE_SECRET=change-me
PUBLIC_BASE=https://server.mewayz.com
# The origin of your Stremio Web app (tightens CORS). Use * only for testing.
ALLOW_ORIGIN=https://server.mewayz.com
# Set if your CDN hosts reject requests without a Referer:
#UPSTREAM_REFERER=https://streamimdb.ru/
#MAX_CONCURRENT=2
#MAX_QUEUE=3
